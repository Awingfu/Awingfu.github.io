---
import { jobs, education } from '../data/experience';
import ExperienceCard from './ExperienceCard.astro';
---

<!-- Experience Section -->
<section id="experience" class="py-20 bg-gray-800">
  <div class="container mx-auto px-4 max-w-5xl">
    <header class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">Experience</h2>
      <p class="text-xl text-gray-300">Where I've worked and what I've built</p>
    </header>

    <!-- Work history timeline -->
    <div class="relative">
      <div class="absolute top-0 bottom-0 left-4 md:left-1/2 w-0.5 bg-blue-600/30 md:-translate-x-1/2"></div>

      <div class="space-y-10">
        {jobs.map((job, i) => (
          <div class="relative md:grid md:grid-cols-2 md:gap-x-8 items-start">
            <span class="absolute left-4 md:left-1/2 top-1.5 -translate-x-1/2 w-3 h-3 rounded-full bg-blue-500 ring-4 ring-gray-800 z-10"></span>

            <div class={i % 2 === 0 ? 'pl-12 md:pl-0 md:pr-8' : 'hidden md:block'}>
              {i % 2 === 0 && <ExperienceCard job={job} align="right" />}
            </div>
            <div class={i % 2 !== 0 ? 'pl-12 md:pl-8' : 'hidden md:block'}>
              {i % 2 !== 0 && <ExperienceCard job={job} align="left" />}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="mt-16">
      <h3 class="text-2xl font-bold text-center mb-8">Education</h3>
      <div class="grid gap-6 md:grid-cols-2">
        {education.map((edu) => (
          <div class="bg-gray-900 rounded-lg p-6 shadow-lg flex items-start space-x-3">
            <svg class="w-6 h-6 text-blue-400 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3z" clip-rule="evenodd" />
              <path d="M3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.65 2.524 1 1 0 01-1.1 0z" />
            </svg>
            <div>
              <h4 class="font-bold text-lg">{edu.school}</h4>
              <p class="text-gray-300">{edu.degree}</p>
              {edu.detail && <p class="text-gray-400 text-sm">{edu.detail}</p>}
              <p class="text-gray-500 text-sm mt-1">{edu.start} &ndash; {edu.end}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
