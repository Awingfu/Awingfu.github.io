---
import { projects } from '../data/projects';
---

<!-- Portfolio Section -->
<section id="portfolio" class="py-20 bg-gray-900">
  <div class="container mx-auto px-4 max-w-6xl">
    <header class="text-center mb-12">
      <h2 class="text-4xl font-bold mb-4">Portfolio</h2>
      <p class="text-xl text-gray-300">Here are projects that I've worked on!</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        project.comingSoon ? (
          <article class="bg-gray-800/50 border-2 border-dashed border-gray-700 rounded-lg flex flex-col items-center justify-center text-center p-8 min-h-64">
            <span class="inline-block bg-blue-600/20 text-blue-300 text-xs font-semibold px-3 py-1 rounded-full mb-4">Coming Soon</span>
            <h3 class="text-xl font-bold mb-2">{project.title}</h3>
            {project.description && <p class="text-gray-400 text-sm">{project.description}</p>}
          </article>
        ) : (
          <article class="bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition transform hover:scale-105">
            <a href={project.href} target="_blank" class="block">
              {project.image && (
                <img src={project.image} alt={`Image for ${project.title}`} class="w-full h-64 object-cover" />
              )}
              <div class="p-6">
                <h3 class="text-2xl font-bold">{project.title}</h3>
                {project.description && <p class="text-gray-400 text-sm mt-2">{project.description}</p>}
              </div>
            </a>
          </article>
        )
      ))}
    </div>
  </div>
</section>
